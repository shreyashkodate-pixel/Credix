# ==============================================================================
# Credix Backend API — Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env and replace placeholders with active credentials.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Application Runtime Mode
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="Credix API"

# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For local offline development without Supabase, SQLite can be used: sqlite:///./credix_dev.db
DATABASE_URL=postgresql://postgres:your_supabase_db_password@db.your_project_ref.supabase.co:5432/postgres

# Security & Authentication (JWT)
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_32_character_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (Allowed Frontend Origins)
# Comma-separated list of origins allowed to make API requests
CORS_ORIGINS=http://localhost:3000,https://credix.vercel.app

# Optional ML Service Configuration
# Leave blank to use direct high-performance Python module colocation
ML_SERVICE_URL=

