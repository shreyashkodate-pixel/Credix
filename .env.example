# ==============================================================================
# Credix — Root Environment Configuration Template (Provisional)
# ==============================================================================
# IMPORTANT:
# - This template is for illustrative and shared development reference only.
# - Do NOT put real secrets, passwords, tokens, or production URLs in this file.
# - Actual environment variables must be stored in uncommitted .env files
#   or the respective hosting provider secret managers (Vercel, Render, Supabase).
# - Service-specific templates (backend/.env.example, frontend/.env.example, ml/.env.example)
#   will be established alongside each application service in subsequent phases.
# ==============================================================================

# Shared Environment Mode (e.g., development, test, production)
ENVIRONMENT=development

# Backend API Configuration (Provisional)
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database Connection (Provisional placeholder - Supabase PostgreSQL)
# Actual credentials must be set in local .env or Render secret store.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=

# ML Service Communication (Provisional)
# Internal/private URL used by the backend to call the ML inference service.
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_SECONDS=10

# Frontend Configuration (Provisional)
# Public API base URL used by the Next.js frontend to contact the backend.
# Note: Next.js public client-side variables must NEVER contain secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

